# =====================================================================
# .env のテンプレート。このファイルは Git で追跡される（実値は書かないこと）。
#
# 使い方:
#   cp .env.example .env  してから各値を埋める。
#   .env は .gitignore 済みなので、ここに書いた実値がコミットされることはない。
#
# 形式:
#   application.properties の spring.config.import で
#   「.properties ファイル」として読み込まれる。つまり KEY=VALUE 形式であり、
#   shell の export やクォートは不要（値の中の " はそのまま文字列になる）。
#
# 優先順位:
#   import されたファイルは application.properties 本体より優先される。
#   そのため下の「任意」欄のように、共通設定を環境ごとに上書きできる。
# =====================================================================

# ---- 必須: DB 接続 ------------------------------------------------
# application.properties が ${DB_USERNAME} / ${DB_PASSWORD} で参照する。
# 未設定だと文字列 "${DB_USERNAME}" のまま接続を試み、Access denied になる。
DB_USERNAME=crm_user
# 値は .betterleaks.toml の allowlist が許すプレースホルダ changeme のままにし、
# 実値は .env 側にだけ書く（ここに実値を書くと秘密スキャンが検知する）。
DB_PASSWORD=changeme

# ---- 必須: JWT 署名鍵 ---------------------------------------------
# HS256 用に 32 バイト以上のランダム文字列。生成例:
#   openssl rand -base64 48
JWT_SECRET=changeme

# ---- 任意: 初期管理者ブートストラップ -------------------------------
# 3つ揃って初めて ADMIN が作られる。空のままなら何も作られない（既定の安全側）。
# 既に ADMIN が存在する場合は AdminBootstrap がスキップする。
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- 任意: 共通設定の上書き ----------------------------------------
# 開発ローカル以外の DB を使う場合のみ設定する（未設定なら localhost:3306/mydb）。
#DB_URL=jdbc:mysql://db.example.com:3306/crm
# SQLログを止めたい環境で有効化する。
#spring.jpa.show-sql=false
#logging.level.com.example.crm=INFO
